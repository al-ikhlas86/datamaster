@using System.Text.Json
@* Port dari flashdata CI4 ("message"/"error"/"warning") dirender via SweetAlert2 -
   PERSIS pola app/Views/templates/index.php (bukan div alert Bootstrap polos).
   String di-encode via JsonSerializer (setara esc($msg,'js') PHP) - aman dari
   JS-injection walau pesan mengandung kutip/backslash (mis. nama siswa/guru). *@
@if (TempData["message"] is string msg)
{
    <script>Swal.fire({ icon: 'success', title: 'Berhasil', text: @Html.Raw(JsonSerializer.Serialize(msg)), timer: 3000, showConfirmButton: false });</script>
}
@if (TempData["warning"] is string warn)
{
    <script>Swal.fire({ icon: 'warning', title: 'Peringatan', text: @Html.Raw(JsonSerializer.Serialize(warn)) });</script>
}
@if (TempData["error"] is string err)
{
    <script>Swal.fire({ icon: 'error', title: 'Gagal', text: @Html.Raw(JsonSerializer.Serialize(err)) });</script>
}
