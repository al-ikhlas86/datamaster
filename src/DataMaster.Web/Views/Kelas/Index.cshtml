@model DataMaster.Web.Models.Kelas.KelasIndexViewModel
@{
    ViewData["Title"] = "Kelola Kelas";
}

<h3 class="mb-3">Kelola Kelas</h3>

<div class="accordion mb-3" id="accordionTingkat">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelTingkat">Kelola Tingkat</button>
        </h2>
        <div id="panelTingkat" class="accordion-collapse collapse" data-bs-parent="#accordionTingkat">
            <div class="accordion-body">
                <form asp-controller="Kurikulum" asp-action="Store" method="post" class="row g-2 mb-3">
                    <input type="hidden" name="kembali_ke" value="kelas" />
                    <div class="col-md-3"><input type="text" name="kode" class="form-control" placeholder="Kode *" required /></div>
                    <div class="col-md-4"><input type="text" name="nama" class="form-control" placeholder="Nama Tampilan *" required /></div>
                    <div class="col-md-2"><input type="number" name="urutan" class="form-control" placeholder="Urutan" value="0" /></div>
                    <div class="col-md-3"><button type="submit" class="btn btn-primary w-100">Tambah</button></div>
                </form>

                <form asp-controller="Kurikulum" asp-action="UpdateBatch" method="post" id="formTingkat">
                    <input type="hidden" name="kembali_ke" value="kelas" />
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Kode</th><th>Nama</th><th>Urutan</th><th>Aktif</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var t in Model.SemuaTingkat)
                        {
                            <tr>
                                <td>@t.Kode</td>
                                <td><input type="text" name="rows[@t.TingkatId].Nama" class="form-control form-control-sm" value="@t.Nama" /></td>
                                <td><input type="number" name="rows[@t.TingkatId].Urutan" class="form-control form-control-sm" value="@t.Urutan" style="width:80px" /></td>
                                <td>
                                    @if (t.IsActive)
                                    {
                                        <input type="checkbox" name="is_active" value="@t.TingkatId" checked />
                                    }
                                    else
                                    {
                                        <input type="checkbox" name="is_active" value="@t.TingkatId" />
                                    }
                                </td>
                                <td>
                                    <form asp-controller="Kurikulum" asp-action="Delete" asp-route-id="@t.TingkatId" method="post" class="d-inline form-hapus-tingkat" data-nama="@t.Nama">
                                        <input type="hidden" name="kembali_ke" value="kelas" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Hapus</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <button type="submit" class="btn btn-outline-primary">Simpan Perubahan Tingkat</button>
                </form>
            </div>
        </div>
    </div>
</div>

<form asp-action="Store" method="post" class="card mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Tingkat</label>
            <select name="tingkat" class="form-select" required>
                @if (Model.SemuaTingkat.Count(t => t.IsActive) == 0)
                {
                    <option value="">-- Belum ada tingkat --</option>
                }
                @foreach (var t in Model.SemuaTingkat.Where(t => t.IsActive))
                {
                    <option value="@t.Kode">@t.Nama</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Nama Kelas</label>
            <input type="text" name="nama_kelas" class="form-control" placeholder="Contoh: Al Mughni" required />
        </div>
        <div class="col-md-3"><button type="submit" class="btn btn-primary w-100">Tambah Kelas</button></div>
        <div class="form-text">Awalan tingkat dibuat otomatis, misalnya tingkat 1 dan nama Al Mughni menjadi Kelas 1 Al Mughni. Kelas yang tidak dipakai lagi diarsipkan agar riwayat tetap utuh.</div>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-md-6"><div class="card text-center"><div class="card-body"><div class="text-muted small">Total Kelas</div><div class="fs-4 fw-bold">@Model.TotalKelas</div></div></div></div>
    <div class="col-md-6"><div class="card text-center"><div class="card-body"><div class="text-muted small">Total Siswa Terdaftar di Kelas</div><div class="fs-4 fw-bold">@Model.TotalSiswa</div></div></div></div>
</div>

@foreach (var grup in Model.PerTingkat)
{
    <div class="card mb-2">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><strong>@grup.Label</strong> <span class="badge bg-secondary">@grup.TotalSiswa siswa</span></span>
            <a asp-action="PrintTingkat" asp-route-tingkat="@grup.Kode" target="_blank" class="btn btn-sm btn-outline-secondary">Print</a>
        </div>
        <div class="card-body">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Nama Kelas</th><th>Jumlah Siswa</th><th>Status</th><th>Aksi</th></tr></thead>
                <tbody>
                @foreach (var k in grup.KelasList)
                {
                    <tr>
                        <td><a asp-action="Detail" asp-route-id="@k.KelasId">@k.NamaKelas</a></td>
                        <td><span class="badge bg-secondary">@k.TotalSiswa</span></td>
                        <td>
                            @if (k.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Arsip</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Detail" asp-route-id="@k.KelasId" class="btn btn-sm btn-outline-info">Detail</a>
                            <a asp-action="Edit" asp-route-id="@k.KelasId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="PrintKelas" asp-route-id="@k.KelasId" target="_blank" class="btn btn-sm btn-outline-secondary">Print</a>
                            @if (k.IsActive)
                            {
                                <form asp-action="Archive" asp-route-id="@k.KelasId" method="post" class="d-inline" onsubmit="return confirm('Arsipkan kelas ini?');">
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Arsipkan</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Restore" asp-route-id="@k.KelasId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Pulihkan</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.form-hapus-tingkat').forEach(function (f) {
            f.addEventListener('submit', function (e) {
                if (!confirm('Hapus tingkat ' + this.dataset.nama + '?')) e.preventDefault();
            });
        });
    </script>
}
