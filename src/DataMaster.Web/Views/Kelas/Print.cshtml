@model List<DataMaster.Web.Models.Siswa.SiswaPrintRow>
@{
    Layout = null;
    var namaKelas = (string)ViewBag.NamaKelas;
    var tingkat = (string)ViewBag.Tingkat;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <title>Daftar Siswa - @namaKelas</title>
    <style>
        body { font-family: Arial, sans-serif; font-size: 11px; margin: 20px; }
        h1, p { text-align: center; margin: 2px 0; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th, td { border: 1px solid #333; padding: 4px 6px; text-align: left; }
        th { background: #eee; }
        .no-print { text-align: center; margin-bottom: 16px; }
        @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    <div class="no-print">
        <button onclick="window.print()">🖨 Cetak Sekarang</button>
        <button onclick="window.close()">✕ Tutup</button>
    </div>
    <h1>Daftar Siswa &mdash; @namaKelas</h1>
    <p>Tingkat @tingkat SD | Dicetak: @DateTime.Now.ToString("dd MMMM yyyy HH:mm")</p>
    <table>
        <thead><tr><th>No</th><th>NIS</th><th>Nama</th><th>JK</th><th>Tempat/Tgl Lahir</th><th>Nama Ayah</th><th>No. HP</th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" style="text-align:center">Tidak ada data siswa.</td></tr>
        }
        else
        {
            var no = 1;
            foreach (var s in Model)
            {
                <tr>
                    <td>@(no++)</td>
                    <td>@s.Nis</td>
                    <td>@s.Nama</td>
                    <td>@s.JenisKelamin</td>
                    <td>@(string.IsNullOrEmpty(s.TempatLahir) && s.TanggalLahir is null ? "-" : $"{s.TempatLahir}, {s.TanggalLahir:dd-MM-yyyy}")</td>
                    <td>@(s.NamaAyah ?? "-")</td>
                    <td>@(s.NoHandphone ?? "-")</td>
                </tr>
            }
        }
        </tbody>
    </table>
</body>
</html>
