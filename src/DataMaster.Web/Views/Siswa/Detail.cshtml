@model DataMaster.Web.Models.Siswa.SiswaFormViewModel
@{
    ViewData["Title"] = "Detail Siswa";
}

<h5 class="text-muted mb-3">@Model.Input.Nama &bull; NIS: @Model.Input.Nis &bull; NISN: @(Model.Input.Nisn ?? "-")</h5>

<div class="row g-3">
    <div class="col-lg-9">
        <form asp-action="Update" asp-route-id="@Model.SiswaId" method="post" enctype="multipart/form-data">
            <partial name="_Form" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Batal</a>
            </div>
        </form>
    </div>
    <div class="col-lg-3">
        <div class="card">
            <div class="card-header"><strong>Ringkasan</strong></div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5">Nama</dt><dd class="col-7">@Model.Input.Nama</dd>
                    <dt class="col-5">NIS</dt><dd class="col-7">@Model.Input.Nis</dd>
                    <dt class="col-5">NISN</dt><dd class="col-7">@(Model.Input.Nisn ?? "-")</dd>
                    <dt class="col-5">Jenis Kelamin</dt><dd class="col-7">@(Model.Input.JenisKelamin == "L" ? "Laki-laki" : "Perempuan")</dd>
                    <dt class="col-5">Ditambahkan</dt><dd class="col-7">@(Model.CreatedAt?.ToString("dd MMM yyyy") ?? "-")</dd>
                </dl>
            </div>
        </div>
        <form asp-action="Delete" asp-route-id="@Model.SiswaId" method="post" class="mt-3 form-delete-siswa" data-nama="@Model.Input.Nama">
            <button type="submit" class="btn btn-danger w-100">Hapus Data Ini</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.form-delete-siswa').forEach(function (f) {
            f.addEventListener('submit', function (e) {
                if (!confirm('Data ' + this.dataset.nama + ' akan dihapus secara permanen. Lanjutkan?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
