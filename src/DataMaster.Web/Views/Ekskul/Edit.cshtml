@model DataMaster.Data.Entities.Ekskul
@{
    ViewData["Title"] = "Edit Ekskul";
}

<h3 class="mb-3">Edit Ekskul</h3>

<div class="card" style="max-width:600px">
    <div class="card-body">
        <form asp-action="Update" asp-route-id="@Model.EkskulId" method="post">
            <div class="mb-3">
                <label class="form-label">Nama Ekskul *</label>
                <input type="text" name="nama" class="form-control @(ViewData.ModelState["nama"] != null ? "is-invalid" : "")" value="@Model.Nama" required />
                @if (ViewData.ModelState["nama"] is { } ms && ms.Errors.Count > 0)
                {
                    <div class="invalid-feedback">@ms.Errors[0].ErrorMessage</div>
                }
            </div>
            <div class="mb-3">
                <label class="form-label">Pembina</label>
                <input type="text" name="pembina" class="form-control" value="@Model.Pembina" />
            </div>
            <div class="mb-3">
                <label class="form-label">Hari Latihan</label>
                <input type="text" name="hari" class="form-control" value="@Model.Hari" />
            </div>
            <div class="mb-3">
                <label class="form-label">Deskripsi</label>
                <textarea name="deskripsi" class="form-control" rows="3">@Model.Deskripsi</textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Simpan</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Batal</a>
            </div>
        </form>
    </div>
</div>
