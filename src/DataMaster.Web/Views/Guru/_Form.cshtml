@model DataMaster.Web.Models.Guru.GuruFormViewModel
@{
    string Err(string key) => Model.Errors.TryGetValue(key, out var v) ? v : "";
    string Cls(string key) => Model.Errors.ContainsKey(key) ? "is-invalid" : "";
}

<div class="card mb-3">
    <div class="card-body">
        @if (Model.IsEdit)
        {
            <div class="mb-3">
                <label class="form-label">Wali Kelas</label>
                <input type="text" class="form-control" value="@(Model.NamaKelasWali ?? "Belum menjadi wali kelas manapun")" readonly disabled />
            </div>
        }
        <div class="mb-3">
            <label class="form-label">Nama Lengkap *</label>
            <input type="text" name="Nama" class="form-control @Cls("Nama")" value="@Model.Input.Nama" required />
            <div class="invalid-feedback">@Err("Nama")</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Jenis Kelamin</label>
            <select name="JenisKelamin" class="form-select @Cls("JenisKelamin")">
                <option value="">-- Pilih --</option>
                @if (Model.Input.JenisKelamin == "L")
                {
                    <option value="L" selected>Laki-laki</option>
                    <option value="P">Perempuan</option>
                }
                else if (Model.Input.JenisKelamin == "P")
                {
                    <option value="L">Laki-laki</option>
                    <option value="P" selected>Perempuan</option>
                }
                else
                {
                    <option value="L">Laki-laki</option>
                    <option value="P">Perempuan</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">NIP</label>
            <input type="text" name="Nip" class="form-control @Cls("Nip")" value="@Model.Input.Nip" />
            <div class="invalid-feedback">@Err("Nip")</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Jabatan *</label>
            <select name="Jabatan" class="form-select @Cls("Jabatan")" required>
                @if (Model.Input.Jabatan == "karyawan")
                {
                    <option value="guru">Guru</option>
                    <option value="karyawan" selected>Karyawan</option>
                }
                else
                {
                    <option value="guru" selected>Guru</option>
                    <option value="karyawan">Karyawan</option>
                }
            </select>
            <div class="form-text">Status Guru Kelas/Guru Bidang serta wali kelas ditentukan OTOMATIS setelah ini disimpan, lewat menu Kelola Kelas — bukan di form ini.</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Mata Pelajaran</label>
            <input type="text" name="MataPelajaran" class="form-control @Cls("MataPelajaran")" value="@Model.Input.MataPelajaran" />
            <div class="form-text">Catatan bebas saja — penugasan mapel resmi diatur di menu Guru Pengampu.</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Gelar Terakhir</label>
            <input type="text" name="GelarTerakhir" class="form-control @Cls("GelarTerakhir")" value="@Model.Input.GelarTerakhir" />
        </div>
        <div class="mb-3">
            <label class="form-label">No. Handphone *</label>
            <input type="text" name="NoHandphone" class="form-control @Cls("NoHandphone")" value="@Model.Input.NoHandphone" required />
            <div class="invalid-feedback">@Err("NoHandphone")</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Alamat</label>
            <input type="text" name="Alamat" class="form-control @Cls("Alamat")" value="@Model.Input.Alamat" />
        </div>
        @if (Model.IsEdit)
        {
            <div class="form-check">
                @if (Model.Input.StatusAktif)
                {
                    <input type="checkbox" name="StatusAktif" value="true" class="form-check-input" id="chkAktif" checked />
                }
                else
                {
                    <input type="checkbox" name="StatusAktif" value="true" class="form-check-input" id="chkAktif" />
                }
                <label class="form-check-label" for="chkAktif">Aktif</label>
            </div>
        }
    </div>
</div>
