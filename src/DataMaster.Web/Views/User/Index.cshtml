@model DataMaster.Web.Models.User.UserSettingsViewModel
@{
    ViewData["Title"] = "Setting";
}

<h3 class="mb-3">Setting</h3>

@* Layout 2 KOLOM TETAP, bukan wrap-per-baris (revisi ke-2, 2026-09-14 -
   percobaan pertama col-lg-6 datar MASIH berantakan: kotak Sinkronisasi
   Hub API yang pendek terpaksa ikut "menunggu" tinggi kolom Ubah Kata
   Sandi/dst di sebelahnya sebelum baris grid berikutnya boleh mulai -
   jarak kosong besar muncul PERSIS di bawah kotak pendek itu, dibuktikan
   screenshot user langsung). Akar masalah SEBENARNYA: col-lg-6 yang
   ditaruh SEJAJAR/DATAR (5 <div class="col-lg-6"> berurutan) tetap
   dianggap Bootstrap sbg baris-baris terpisah (wrap tiap 2), BUKAN 2
   kolom independen - tinggi 1 "baris" tetap mengikuti kotak TERTINGGI
   di baris itu.

   FIX SEBENARNYA: cuma 2 <div class="col-lg-6"> di root (bukan 5) -
   MASING-MASING isinya beberapa <div class="card mt-3"> ditumpuk
   LANGSUNG di dalamnya, independen total dari tinggi kolom sebelah.
   Kiri = identitas akun, kanan = konektivitas & data (Hub API tetap
   pendek apa adanya, TIDAK ada lagi yang menunggu apa pun). *@
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Profil</div>
            <div class="card-body text-center">
                <img id="previewFoto" src="~/img/@(Model.UserImage ?? "default.png")" onerror="this.src='https://via.placeholder.com/120?text=Foto'"
                     class="rounded-circle mb-3" style="width:120px;height:120px;object-fit:cover;cursor:pointer" onclick="document.getElementById('inputFoto').click()" />
                <div>
                    <span class="badge @(Model.Active ? "bg-success" : "bg-secondary")">@(Model.Active ? "Aktif" : "Tidak Aktif")</span>
                </div>
                <form asp-controller="User" asp-action="Update" method="post" enctype="multipart/form-data" class="mt-3 text-start">
                    <input type="file" id="inputFoto" name="user_image" accept=".jpg,.jpeg,.png" class="d-none" onchange="document.getElementById('previewFoto').src=URL.createObjectURL(this.files[0])" />
                    <div class="form-text mb-2">Klik foto untuk mengganti. JPG/PNG, maksimal 500KB.</div>
                    <div class="mb-3">
                        <label class="form-label">ID</label>
                        <input type="text" name="username" class="form-control" value="@Model.Username" minlength="3" maxlength="30" required />
                        <div class="form-text">Dipakai untuk login - ganti kapan saja, berlaku mulai login berikutnya.</div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Simpan Profil</button>
                </form>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">Ubah Kata Sandi</div>
            <div class="card-body">
                <form asp-controller="User" asp-action="UpdatePassword" method="post">
                    <div class="mb-2">
                        <label class="form-label">Kata Sandi Lama *</label>
                        <input type="password" name="password_lama" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Kata Sandi Baru *</label>
                        <input type="password" name="password_baru" class="form-control" minlength="8" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Konfirmasi Kata Sandi Baru *</label>
                        <input type="password" name="password_baru_konfirmasi" class="form-control" minlength="8" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Ubah Kata Sandi</button>
                </form>
            </div>
        </div>
        <div class="card mt-3">
            <div class="card-header">Kode Pemulihan</div>
            <div class="card-body">
                <p class="fs-12 text-muted">Dipakai untuk reset password lewat halaman "Lupa Password" kalau suatu saat lupa & tidak bisa login. Simpan di tempat aman - hilang tidak bisa dilihat ulang, cuma bisa di-generate ulang (kode lama otomatis tidak berlaku).</p>
                <form asp-controller="User" asp-action="GenerateUlangKodePemulihan" method="post" onsubmit="return confirm('Kode Pemulihan LAMA (kalau ada) akan langsung tidak berlaku. Lanjutkan buat kode baru?');">
                    <button type="submit" class="btn btn-outline-secondary w-100">Buat Kode Pemulihan Baru</button>
                </form>
            </div>
        </div>
        <div class="card mt-3">
            <div class="card-header">Logout</div>
            <div class="card-body">
                <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger w-100">Keluar</a>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Sinkronisasi Hub API</div>
            <div class="card-body">
                @{
                    var (hubBadge, hubLabel) = Model.HubApiStatus switch
                    {
                        "aktif" => ("bg-success", "Aktif"),
                        "pending" => ("bg-warning text-dark", "Menunggu Persetujuan Admin"),
                        "menyambungkan" => ("bg-info text-dark", "Menyambungkan..."),
                        _ => ("bg-secondary", "Belum Tersambung"),
                    };
                }
                <p class="mb-3">
                    Status: <span class="badge @hubBadge">@hubLabel</span>
                </p>
                @if (Model.HubApiStatus == "pending")
                {
                    <p class="text-muted small mb-0">Unit ini sudah terdaftar, tapi Hub API BELUM menyetujuinya - hubungi admin Hub API untuk klik "Setujui" di panel admin. Sinkronisasi otomatis mulai jalan begitu disetujui, tanpa perlu apa pun dari sini.</p>
                }
                else if (Model.HubApiStatus is "aktif" or "menyambungkan")
                {
                    <p class="text-muted small mb-0">Sinkronisasi ke Mobile-app/Webview berjalan otomatis tiap 1 menit.</p>
                }
                else
                {
                    <form asp-controller="User" asp-action="SambungkanHubApi" method="post"
                          onsubmit="return confirm('Daftarkan unit ini ke Hub API? Perlu persetujuan admin dulu sebelum sinkronisasi mulai jalan. Aplikasi akan restart otomatis.')">
                        <label class="form-label">Nama Unit</label>
                        <input type="text" name="nama_unit" class="form-control mb-2" placeholder="Contoh: TK Al Ikhlas 86" required />
                        <div class="form-text mb-2">Isi supaya data unit ini otomatis tersambung ke Mobile-app/Webview - cukup nama unitnya saja. Setelah didaftarkan, admin Hub API perlu menyetujui dulu sebelum sinkronisasi benar-benar mulai.</div>
                        <button type="submit" class="btn btn-primary w-100">Daftarkan</button>
                    </form>
                }
            </div>
        </div>

        @if (Model.LanMode == "server")
        {
            <div class="card mt-3">
                <div class="card-header">Info Jaringan (PC ini jadi Server)</div>
                <div class="card-body">
                    <p class="mb-1 small text-muted">Alamat untuk diisi di PC klien</p>
                    <div class="input-group mb-2">
                        <input type="text" id="lanAddress" class="form-control" readonly value="http://@(Model.LanHostname):@(Model.LanPort)" />
                        <button type="button" class="btn btn-outline-secondary" onclick="salinAlamatLan()">Salin</button>
                    </div>
                    <p id="lanCopiedMsg" class="small text-success mb-0 d-none">Alamat disalin ke clipboard.</p>
                    <p class="small text-muted mt-2 mb-0">Tempel (paste) alamat ini di kotak "Alamat PC server" saat setup awal PC klien lain di jaringan yang sama.</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.AppVersion))
        {
            <p class="text-muted small mt-2 mb-0">Versi aplikasi: v@(Model.AppVersion)</p>
        }

        <div class="card mt-3">
            <div class="card-header">Backup &amp; Pemulihan</div>
            <div class="card-body">
                <p class="mb-1 small text-muted">Backup Manual Terakhir</p>
                <p class="mb-3">@(Model.LastBackupManualAt?.ToString("d MMM yyyy HH:mm") ?? "-")</p>
                <p class="mb-1 small text-muted">Backup Online Terakhir</p>
                <p class="mb-3">@(Model.LastBackupOnlineAt?.ToString("d MMM yyyy HH:mm") ?? "-")</p>

                @if (!Model.BackupPassphraseAktif)
                {
                    <div class="alert alert-warning py-2 px-3 small mb-3">
                        <strong>Backup Online belum aktif.</strong> Isi Kata Sandi Backup Awan di bawah dulu (sekali saja) - tanpa ini, Backup Online TIDAK PERNAH berjalan walau jam sudah diatur.
                    </div>
                }
                <form asp-controller="User" asp-action="SimpanBackupPassphrase" method="post" class="mb-3">
                    <label class="small text-muted mb-1">Kata Sandi Backup Awan @(Model.BackupPassphraseAktif ? "(sudah diisi - isi ulang utk mengganti)" : "(belum diisi)")</label>
                    <div class="input-group">
                        <input type="password" name="passphrase" class="form-control" minlength="16" placeholder="Minimal 16 karakter" required />
                        <button type="submit" class="btn btn-outline-secondary">Simpan</button>
                    </div>
                    <p class="small text-muted mt-1 mb-0">Dipakai mengenkripsi backup sebelum dikirim ke luar - SIMPAN baik-baik, sandi hilang = backup lama tidak bisa dibuka lagi.</p>
                </form>

                <form asp-controller="User" asp-action="SimpanJadwalBackup" method="post" class="d-flex gap-2 mb-3">
                    <select name="jam_backup" class="form-select">
                        @for (var h = 0; h < 24; h++)
                        {
                            if (h == Model.JamBackupOnline) { <option value="@h" selected>@h:00</option> }
                            else { <option value="@h">@h:00</option> }
                        }
                    </select>
                    <button type="submit" class="btn btn-outline-secondary">Simpan Jam</button>
                </form>

                <form asp-controller="User" asp-action="BackupManual" method="post" class="mb-2"
                      onsubmit="return confirm('Buat backup manual sekarang?')">
                    <button type="submit" class="btn btn-primary w-100">Backup Manual Sekarang</button>
                </form>

                <button type="button" class="btn btn-outline-warning w-100" data-bs-toggle="modal" data-bs-target="#modalRestore">Pemulihan Data</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalRestore" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="User" asp-action="Restore" method="post" enctype="multipart/form-data" id="formRestore">
                <div class="modal-header"><h5 class="modal-title text-danger">Pemulihan Data</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="alert alert-danger">Seluruh isi database AKTIF akan DITIMPA oleh isi berkas ini. Operasi ini tidak bisa dibatalkan setelah berjalan.</div>
                    <div class="mb-3">
                        <label class="form-label">Berkas Backup (.db atau .db.enc) *</label>
                        <input type="file" name="file" id="fileRestore" class="form-control" accept=".db,.enc" required
                               onchange="document.getElementById('grupSandi').classList.toggle('d-none', !this.value.toLowerCase().endsWith('.enc'))" />
                    </div>
                    <div class="mb-3 d-none" id="grupSandi">
                        <label class="form-label">Sandi Pemulihan</label>
                        <input type="password" name="sandi_restore" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ketik <strong>TIMPA</strong> untuk konfirmasi *</label>
                        <input type="text" name="konfirmasi_restore" id="konfirmasiRestore" class="form-control" oninput="document.getElementById('btnRestore').disabled = this.value.trim().toUpperCase() !== 'TIMPA'" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-danger" id="btnRestore" disabled>Timpa &amp; Pulihkan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.LanMode == "server")
{
    <script>
        function salinAlamatLan() {
            var el = document.getElementById('lanAddress');
            el.select();
            navigator.clipboard.writeText(el.value).then(function () {
                document.getElementById('lanCopiedMsg').classList.remove('d-none');
            });
        }
    </script>
}
