<Window x:Class="DataMaster.Launcher.UpdateSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Master" Height="220" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        Background="#1F2937">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">
            <TextBlock Text="Data Master" FontSize="28" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="Al-Ikhlas 86" FontSize="13"
                       Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,28"/>
            <ProgressBar IsIndeterminate="True" Height="4"
                         Background="#374151" Foreground="#22C55E" BorderThickness="0"/>
            <TextBlock x:Name="TxtStatus" Text="Memeriksa pembaruan..." FontSize="13"
                       Foreground="#D1D5DB" HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
