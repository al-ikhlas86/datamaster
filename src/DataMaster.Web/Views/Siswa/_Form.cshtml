@model DataMaster.Web.Models.Siswa.SiswaFormViewModel
@{
    string Err(string key) => Model.Errors.TryGetValue(key, out var v) ? v : "";
    string Cls(string key) => Model.Errors.ContainsKey(key) ? "is-invalid" : "";
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card mb-3">
            <div class="card-header"><strong>Identitas Siswa</strong></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Nama Lengkap *</label>
                    <input type="text" name="Nama" class="form-control @Cls("Nama")" value="@Model.Input.Nama" placeholder="Nama lengkap siswa" required />
                    <div class="invalid-feedback">@Err("Nama")</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Jenis Kelamin *</label>
                    <select name="JenisKelamin" class="form-select @Cls("JenisKelamin")" required>
                        <option value="">-- Pilih --</option>
                        @if (Model.Input.JenisKelamin == "L")
                        {
                            <option value="L" selected>Laki-laki</option>
                            <option value="P">Perempuan</option>
                        }
                        else if (Model.Input.JenisKelamin == "P")
                        {
                            <option value="L">Laki-laki</option>
                            <option value="P" selected>Perempuan</option>
                        }
                        else
                        {
                            <option value="L">Laki-laki</option>
                            <option value="P">Perempuan</option>
                        }
                    </select>
                    <div class="invalid-feedback">@Err("JenisKelamin")</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">NIS *</label>
                    <input type="text" name="Nis" class="form-control @Cls("Nis")" value="@Model.Input.Nis" placeholder="Nomor Induk Siswa" required />
                    <div class="invalid-feedback">@Err("Nis")</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">NISN</label>
                    <input type="text" name="Nisn" class="form-control @Cls("Nisn")" value="@Model.Input.Nisn" placeholder="Nomor Induk Siswa Nasional" />
                    <div class="form-text">NISN adalah nomor identitas siswa yang bersifat nasional dan unik</div>
                    <div class="invalid-feedback">@Err("Nisn")</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Kelas</label>
                    <select name="KelasId" class="form-select">
                        <option value="">-- Belum ada kelas --</option>
                        @foreach (var k in Model.KelasOptions)
                        {
                            if (k.KelasId == Model.Input.KelasId)
                            {
                                <option value="@k.KelasId" selected>@k.NamaKelas</option>
                            }
                            else
                            {
                                <option value="@k.KelasId">@k.NamaKelas</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Tempat Lahir</label>
                    <input type="text" name="TempatLahir" class="form-control @Cls("TempatLahir")" value="@Model.Input.TempatLahir" placeholder="Kota tempat lahir" />
                    <div class="invalid-feedback">@Err("TempatLahir")</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Tanggal Lahir</label>
                    <input type="date" name="TanggalLahir" class="form-control" value="@Model.Input.TanggalLahir?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Asal Sekolah</label>
                    <input type="text" name="AsalSekolah" class="form-control @Cls("AsalSekolah")" value="@Model.Input.AsalSekolah" placeholder="Nama sekolah asal" />
                    <div class="invalid-feedback">@Err("AsalSekolah")</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Alamat Rumah</label>
                    <input type="text" name="AlamatJalan" class="form-control @Cls("AlamatJalan")" value="@Model.Input.AlamatJalan" placeholder="Nama jalan dan nomor rumah" />
                    <div class="invalid-feedback">@Err("AlamatJalan")</div>
                </div>
                <div class="row g-2">
                    <div class="col-3">
                        <label class="form-label">RT</label>
                        <input type="text" name="AlamatRt" maxlength="5" class="form-control @Cls("AlamatRt")" value="@Model.Input.AlamatRt" placeholder="RT" />
                        <div class="invalid-feedback">@Err("AlamatRt")</div>
                    </div>
                    <div class="col-3">
                        <label class="form-label">RW</label>
                        <input type="text" name="AlamatRw" maxlength="5" class="form-control @Cls("AlamatRw")" value="@Model.Input.AlamatRw" placeholder="RW" />
                        <div class="invalid-feedback">@Err("AlamatRw")</div>
                    </div>
                    <div class="col-3">
                        <label class="form-label">Kelurahan</label>
                        <input type="text" name="AlamatKelurahan" class="form-control @Cls("AlamatKelurahan")" value="@Model.Input.AlamatKelurahan" placeholder="Kelurahan" />
                        <div class="invalid-feedback">@Err("AlamatKelurahan")</div>
                    </div>
                    <div class="col-3">
                        <label class="form-label">Kecamatan</label>
                        <input type="text" name="AlamatKecamatan" class="form-control @Cls("AlamatKecamatan")" value="@Model.Input.AlamatKecamatan" placeholder="Kecamatan" />
                        <div class="invalid-feedback">@Err("AlamatKecamatan")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card mb-3">
            <div class="card-header"><strong>Data Orang Tua / Wali</strong></div>
            <div class="card-body">
                <h6 class="text-muted">Data Ayah</h6>
                <div class="mb-3">
                    <label class="form-label">Nama Ayah</label>
                    <input type="text" name="NamaAyah" class="form-control @Cls("NamaAyah")" value="@Model.Input.NamaAyah" placeholder="Nama lengkap ayah" />
                    <div class="invalid-feedback">@Err("NamaAyah")</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Pekerjaan Ayah</label>
                    <input type="text" name="PekerjaanAyah" class="form-control @Cls("PekerjaanAyah")" value="@Model.Input.PekerjaanAyah" placeholder="Contoh: Wiraswasta, PNS, dll" />
                    <div class="invalid-feedback">@Err("PekerjaanAyah")</div>
                </div>
                <h6 class="text-muted">Data Ibu</h6>
                <div class="mb-3">
                    <label class="form-label">Nama Ibu</label>
                    <input type="text" name="NamaIbu" class="form-control @Cls("NamaIbu")" value="@Model.Input.NamaIbu" placeholder="Nama lengkap ibu" />
                    <div class="invalid-feedback">@Err("NamaIbu")</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Pekerjaan Ibu</label>
                    <input type="text" name="PekerjaanIbu" class="form-control @Cls("PekerjaanIbu")" value="@Model.Input.PekerjaanIbu" placeholder="Contoh: Ibu Rumah Tangga, Guru, dll" />
                    <div class="invalid-feedback">@Err("PekerjaanIbu")</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">No. Handphone (Utama) *</label>
                    <input type="text" name="NoHandphone" class="form-control @Cls("NoHandphone")" value="@Model.Input.NoHandphone" placeholder="Contoh: 08123456789" required />
                    <div class="form-text">Dipakai membuat akun Orang Tua pertama di aplikasi HP.</div>
                    <div class="invalid-feedback">@Err("NoHandphone")</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">No. Handphone Ke-2 (Opsional)</label>
                    <input type="text" name="NoHandphoneKedua" class="form-control @Cls("NoHandphoneKedua")" value="@Model.Input.NoHandphoneKedua" placeholder="Contoh: 08129876543 (ayah atau ibu, milik nomor pertama)" />
                    <div class="form-text">Isi kalau ayah DAN ibu ingin masing-masing punya akun sendiri di aplikasi HP.</div>
                    <div class="invalid-feedback">@Err("NoHandphoneKedua")</div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><strong>Dokumen Siswa</strong></div>
            <div class="card-body">
                <div class="alert alert-info small">Format: PDF, JPG, JPEG, PNG — Maks. 2MB per file.</div>
                @{
                    var dokumenFields = new (string Name, string Label, string? Lama, string Err)[]
                    {
                        ("DokumenKk", "Kartu Keluarga (KK)", Model.DokumenKkLama, Err("DokumenKK")),
                        ("DokumenAkta", "Akta Kelahiran", Model.DokumenAktaLama, Err("DokumenAkta")),
                        ("DokumenKia", "Kartu Identitas Anak (KIA)", Model.DokumenKiaLama, Err("DokumenKIA")),
                        ("DokumenIjazah", "Ijazah", Model.DokumenIjazahLama, Err("DokumenIjazah")),
                    };
                }
                @foreach (var (name, label, lama, err) in dokumenFields)
                {
                    <div class="mb-3">
                        <label class="form-label">@label</label>
                        @if (Model.IsEdit && !string.IsNullOrEmpty(lama))
                        {
                            <div class="mb-2 d-flex align-items-center gap-2">
                                <a asp-action="Dokumen" asp-route-id="@Model.SiswaId" asp-route-field="@name" target="_blank" class="btn btn-sm btn-outline-secondary">Lihat</a>
                                <form asp-action="DeleteDokumen" asp-route-id="@Model.SiswaId" asp-route-field="@name" method="post" onsubmit="return confirm('Dokumen ini akan dihapus secara permanen.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                            <div class="form-text">Upload file baru untuk mengganti:</div>
                        }
                        <input type="file" name="@name" class="form-control @(err != "" ? "is-invalid" : "")" accept=".pdf,.jpg,.jpeg,.png" />
                        <div class="invalid-feedback">@err</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
