<Window x:Class="DataMaster.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:DataMaster.Launcher"
        mc:Ignorable="d"
        Title="Data Master" Height="800" Width="1280"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="900"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowState="Maximized">
    <Grid>
        <!-- Konten utama: browser lokal ke DataMaster.Web (Kestrel 127.0.0.1)
             Ditampilkan penuh sekali server siap - lihat MainWindow.xaml.cs -->
        <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />

        <!-- Splash - ditampilkan SELAMA server dinyalakan & cek update,
             disembunyikan tepat sebelum Browser dimunculkan (bukan dihapus,
             cuma Collapsed, supaya bisa dipakai lagi kalau server perlu
             di-restart nanti mis. sesudah update terpasang). -->
        <Grid x:Name="SplashOverlay" Background="#1F2937">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                <TextBlock Text="Data Master" FontSize="32" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Al-Ikhlas 86" FontSize="14"
                           Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,32"/>
                <ProgressBar x:Name="SplashProgress" IsIndeterminate="True" Height="4"
                             Background="#374151" Foreground="#22C55E" BorderThickness="0"/>
                <TextBlock x:Name="SplashStatus" Text="Memeriksa pembaruan..." FontSize="13"
                           Foreground="#D1D5DB" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Elemen PALING TERAKHIR di Grid ini = tampil PALING ATAS (di atas
             Browser MAUPUN SplashOverlay) - sengaja begitu supaya PC mode Klien
             yang berpindah ruangan/jaringan (mis. mau ganti dari server A ke
             server B) selalu bisa akses ini TANPA perlu tahu URL server MANA
             yang sedang ditampilkan WebView2 di baliknya. -->
        <Button x:Name="BtnGantiJaringan" Content="⚙ Ganti Pengaturan Jaringan"
                Click="BtnGantiJaringan_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                Padding="8,4" FontSize="11" Opacity="0.55"
                Background="#1F2937" Foreground="White" BorderThickness="0"/>
    </Grid>
</Window>
