@model DataMaster.Web.Models.Dashboard.DashboardPerusahaanViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h3 class="mb-3">Dashboard</h3>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><div class="text-muted small">Total Pegawai Aktif</div><div class="fs-4 fw-bold">@Model.TotalPegawai</div></div></div></div>
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><div class="text-muted small">Laki-laki</div><div class="fs-4 fw-bold">@Model.TotalL</div></div></div></div>
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><div class="text-muted small">Perempuan</div><div class="fs-4 fw-bold">@Model.TotalP</div></div></div></div>
</div>

<div class="card mb-3">
    <div class="card-header">Distribusi Jenis Kelamin</div>
    <div class="card-body">
        @{
            var total = Model.TotalL + Model.TotalP;
            var pctL = total > 0 ? Model.TotalL * 100 / total : 0;
            var pctP = total > 0 ? Model.TotalP * 100 / total : 0;
        }
        <div class="d-flex justify-content-between"><span>Laki-laki</span><span>@Model.TotalL (@pctL%)</span></div>
        <div class="progress mb-2" style="height:10px"><div class="progress-bar bg-primary" style="width:@(pctL)%"></div></div>
        <div class="d-flex justify-content-between"><span>Perempuan</span><span>@Model.TotalP (@pctP%)</span></div>
        <div class="progress" style="height:10px"><div class="progress-bar bg-danger" style="width:@(pctP)%"></div></div>
    </div>
</div>

<div class="card">
    <div class="card-header">Pegawai Terbaru Ditambahkan</div>
    <div class="card-body">
        @if (Model.RecentPegawai.Count == 0)
        {
            <p class="text-muted mb-0">Belum ada pegawai.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead><tr><th>No</th><th>Nama</th><th>JK</th><th>No. HP</th><th></th></tr></thead>
                <tbody>
                    @{ var no = 1; }
                    @foreach (var p in Model.RecentPegawai)
                    {
                        <tr>
                            <td>@(no++)</td><td>@p.Nama</td><td>@p.JenisKelamin</td><td>@p.NoHandphone</td>
                            <td><a asp-controller="Guru" asp-action="Detail" asp-route-id="@p.GuruId" class="btn btn-sm btn-outline-secondary">Detail</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
