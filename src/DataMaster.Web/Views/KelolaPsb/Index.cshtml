@{
    ViewData["Title"] = "Kelola PSB";
    var url = ViewData["UrlPsb"] as string;
    var galat = ViewData["PesanGalat"] as string;
}

@if (url is null)
{
    <div class="card">
        <div class="card-body">
            <h5 class="mb-2">Kelola PSB Online</h5>
            <div class="alert alert-danger mb-3">@(galat ?? "Tidak bisa membuka Kelola PSB.")</div>
            <a asp-action="Index" class="btn btn-primary"><i class="feather-refresh-cw me-1"></i> Coba lagi</a>
        </div>
    </div>
}
else
{
    @* Halaman PSB webview ditanam di sini (masuk otomatis lewat tiket sekali pakai); tidak membuka tab baru. *@
    <iframe src="@url" title="Kelola PSB" style="width:100%;height:calc(100vh - 140px);min-height:520px;border:0;border-radius:8px;background:#fff" referrerpolicy="no-referrer"></iframe>
}
