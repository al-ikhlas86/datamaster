@model DataMaster.Web.Models.Kelas.KelasDetailViewModel
@{
    ViewData["Title"] = "Detail Kelas";
}

<h5 class="text-muted mb-3">Tingkat @Model.Tingkat@(int.TryParse(Model.Tingkat, out _) ? " SD" : "") &bull; Wali Kelas: <strong>@(Model.WaliKelas ?? "-")</strong> &bull; @Model.SiswaKelas.Count siswa</h5>
<h3 class="mb-3">@Model.NamaKelas</h3>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header"><strong>Siswa di Kelas Ini</strong></div>
            <div class="card-body">
                <table class="table table-sm align-middle">
                    <thead><tr><th>NIS</th><th>Nama</th><th>JK</th><th>Aksi</th></tr></thead>
                    <tbody>
                    @if (Model.SiswaKelas.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted">Belum ada siswa di kelas ini.</td></tr>
                    }
                    else
                    {
                        foreach (var s in Model.SiswaKelas)
                        {
                            <tr>
                                <td>@s.Nis</td>
                                <td>@s.Nama</td>
                                <td>@s.JenisKelamin</td>
                                <td>
                                    <form asp-action="RemoveSiswa" asp-route-kelasId="@Model.KelasId" asp-route-siswaId="@s.SiswaId" method="post" onsubmit="return confirm('Keluarkan @s.Nama dari kelas?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Keluarkan</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header"><strong>Tambah Siswa (belum punya kelas)</strong></div>
            <div class="card-body">
                <form asp-action="AddSiswa" asp-route-id="@Model.KelasId" method="post">
                    @if (Model.SiswaTanpaKelas.Count == 0)
                    {
                        <p class="text-muted">Tidak ada siswa tanpa kelas saat ini.</p>
                    }
                    else
                    {
                        <div class="mb-2">
                            <button type="button" class="btn btn-sm btn-link p-0" onclick="document.querySelectorAll('.js-siswa-check').forEach(c=>c.checked=true)">Pilih Semua</button>
                            /
                            <button type="button" class="btn btn-sm btn-link p-0" onclick="document.querySelectorAll('.js-siswa-check').forEach(c=>c.checked=false)">Batal Pilih</button>
                        </div>
                        <div style="max-height:300px;overflow-y:auto">
                        @foreach (var s in Model.SiswaTanpaKelas)
                        {
                            <div class="form-check">
                                <input class="form-check-input js-siswa-check" type="checkbox" name="siswa_ids" value="@s.SiswaId" id="chk@(s.SiswaId)" />
                                <label class="form-check-label" for="chk@(s.SiswaId)">@s.Nama (@s.Nis)</label>
                            </div>
                        }
                        </div>
                        <button type="submit" class="btn btn-primary mt-2">Tambahkan</button>
                    }
                </form>
            </div>
        </div>
    </div>
</div>
