@model DataMaster.Web.Models.Auth.LupaPasswordInput
@{
    Layout = null;
    ViewData["Title"] = "Lupa Password";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Lupa Password - Sistem Arsip Data SDIT AL IKHLAS 86</title>
    <link rel="shortcut icon" type="image/x-icon" href="~/assets/images/logo-abbr.png">
    <link rel="stylesheet" type="text/css" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/assets/vendors/css/vendors.min.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/theme.min.css">
</head>
<body>
    <main class="auth-cover-wrapper">
        <div class="auth-cover-content-inner">
            <div class="auth-cover-content-wrapper">
                <div class="auth-img">
                    <img src="~/assets/images/logo-abbr.png" alt="Logo" class="img-fluid mx-auto d-block" style="width: 100%; max-width: 420px;">
                </div>
            </div>
        </div>
        <div class="auth-cover-sidebar-inner">
            <div class="auth-cover-card-wrapper">
                <div class="auth-cover-card p-sm-5">
                    <h2 class="fs-20 fw-bolder mb-4">Lupa Password</h2>
                    <p class="fs-12 fw-medium text-muted">
                        Masukkan Kode Pemulihan yang diberikan saat akun ini dibuat (atau saat terakhir kali di-generate ulang dari menu Pengaturan).
                        Kalau Anda tidak punya/lupa Kode Pemulihannya juga, hubungi Admin IT Yayasan untuk pemulihan lewat database.
                    </p>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@err.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <form asp-controller="Auth" asp-action="LupaPassword" method="post" class="w-100 mt-4 pt-2">
                        <div class="mb-3">
                            <label class="form-label">ID / Username</label>
                            <input type="text" class="form-control" name="Login" value="@Model.Login" required autofocus>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Kode Pemulihan</label>
                            <input type="text" class="form-control" name="KodePemulihan" placeholder="XXXX-XXXX-XXXX-XXXX" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password Baru</label>
                            <input type="password" class="form-control" name="PasswordBaru" minlength="8" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Konfirmasi Password Baru</label>
                            <input type="password" class="form-control" name="PasswordBaruKonfirmasi" minlength="8" required>
                        </div>
                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-lg btn-primary flex-grow-1">Reset Password</button>
                        </div>
                        <div class="mt-3 text-center">
                            <a asp-controller="Auth" asp-action="Login" class="fs-11 fw-medium">Kembali ke Login</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
    <script src="~/assets/vendors/js/vendors.min.js"></script>
    <script src="~/assets/js/common-init.min.js"></script>
    <script src="~/assets/js/theme-customizer-init.min.js"></script>
</body>
</html>
