<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DataMaster.Data\DataMaster.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Dibutuhkan System.Windows.Forms.NotifyIcon (ikon system tray) - lihat
         MainWindow.xaml.cs, mencegah tombol X mode Server/Mandiri sengaja/tidak
         sengaja mematikan server yang sedang dipakai PC klien lain. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Dibandingkan UpdateChecker terhadap tag rilis GitHub (vX.Y.Z) - naikkan
         tiap kali CI/CD menerbitkan rilis baru. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
