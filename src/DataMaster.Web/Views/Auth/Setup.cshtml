@model DataMaster.Web.Models.Auth.SetupInput
@{
    Layout = null;
    ViewData["Title"] = "Setup Awal";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Setup Awal - Data Master</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
<div class="container" style="max-width:460px;margin-top:6vh">
    <div class="text-center mb-4">
        <h3>Data Master</h3>
        <p class="text-muted">Al-Ikhlas 86 &mdash; Setup Awal</p>
    </div>
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h5 class="card-title mb-1">Buat Akun Admin</h5>
            <p class="text-muted small mb-3">Belum ada akun sama sekali di aplikasi ini. Buat akun admin pertama untuk mulai memakai Data Master. Setelah ini, akun baru lain hanya bisa dibuat oleh admin yang sudah masuk.</p>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }
            <form asp-controller="Auth" asp-action="Setup" method="post">
                <div class="mb-3">
                    <label class="form-label">Email *</label>
                    <input type="email" name="Email" class="form-control" value="@Model.Email" required autofocus />
                </div>
                <div class="mb-3">
                    <label class="form-label">Username (opsional)</label>
                    <input type="text" name="Username" class="form-control" value="@Model.Username" maxlength="30" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Kata Sandi *</label>
                    <input type="password" name="Password" class="form-control" minlength="8" required />
                    <div class="form-text">Minimal 8 karakter.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Konfirmasi Kata Sandi *</label>
                    <input type="password" name="PasswordKonfirmasi" class="form-control" minlength="8" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">Buat Akun Admin</button>
            </form>
        </div>
    </div>
</div>
</body>
</html>
