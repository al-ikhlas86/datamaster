@model DataMaster.Web.Models.Auth.LoginInput
@{
    Layout = null;
    ViewData["Title"] = "Masuk";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Masuk - Sistem Arsip Data SDIT AL IKHLAS 86</title>
    <script>
        (function () {
            var html = document.documentElement;
            var nav = localStorage.getItem('app-navigation');
            if (nav) html.classList.add(nav);
            var header = localStorage.getItem('app-header');
            if (header) html.classList.add(header);
            if (localStorage.getItem('app-skin-dark') === 'app-skin-dark') html.classList.add('app-skin-dark');
            var font = localStorage.getItem('font-family');
            if (font) html.classList.add(font);
        })();
    </script>
    <link rel="shortcut icon" type="image/x-icon" href="~/assets/images/logo-abbr.png">
    <link rel="stylesheet" type="text/css" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/assets/vendors/css/vendors.min.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/theme.min.css">
</head>
<body>
    <main class="auth-cover-wrapper">
        <div class="auth-cover-content-inner">
            <div class="auth-cover-content-wrapper">
                <div class="auth-img">
                    <img src="~/assets/images/logo-abbr.png" alt="Logo" class="img-fluid mx-auto d-block" style="width: 100%; max-width: 420px;">
                </div>
            </div>
        </div>
        <div class="auth-cover-sidebar-inner">
            <div class="auth-cover-card-wrapper">
                <div class="auth-cover-card p-sm-5">
                    <h2 class="fs-20 fw-bolder mb-4">Masuk</h2>
                    <h4 class="fs-13 fw-bold mb-2">Data Master SDIT AL IKHLAS 86</h4>
                    <p class="fs-12 fw-medium text-muted">Selamat datang kembali! Silahkan login ke akun Anda.</p>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@err.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <form asp-controller="Auth" asp-action="Login" method="post" class="w-100 mt-4 pt-2">
                        <div class="mb-4">
                            <input type="text" class="form-control" name="Login" placeholder="Email atau Username" value="@Model.Login" required autofocus>
                        </div>
                        <div class="mb-3">
                            <input type="password" class="form-control" name="Password" placeholder="Kata Sandi" required>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" name="IngatLogin" value="true" id="rememberMe">
                                <label class="custom-control-label c-pointer" for="rememberMe">Ingat login (30 hari)</label>
                            </div>
                        </div>
                        <div class="mt-5">
                            <button type="submit" class="btn btn-lg btn-primary w-100">Masuk</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
    <script src="~/assets/vendors/js/vendors.min.js"></script>
    <script src="~/assets/js/common-init.min.js"></script>
    <script src="~/assets/js/theme-customizer-init.min.js"></script>
</body>
</html>
