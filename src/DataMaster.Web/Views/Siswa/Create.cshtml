@model DataMaster.Web.Models.Siswa.SiswaFormViewModel
@{
    ViewData["Title"] = "Tambah Data Siswa";
}

<h3 class="mb-3">Tambah Data Siswa</h3>

<form asp-action="Store" method="post" enctype="multipart/form-data">
    <partial name="_Form" model="Model" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary btn-lg">Simpan Data Siswa</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Batal</a>
    </div>
</form>
