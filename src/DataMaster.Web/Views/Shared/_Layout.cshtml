<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Sistem Data Master SDIT AL IKHLAS 86">

    @* Title SENGAJA STATIS (tidak berubah per halaman) - port PERSIS
       app/Views/templates/index.php, keputusan desain PHP asli, bukan celah. *@
    <title>Sistem Arsip Data - SDIT AL IKHLAS 86</title>

    <script>
        (function () {
            var html = document.documentElement;
            var nav = localStorage.getItem('app-navigation');
            if (nav) html.classList.add(nav);
            var header = localStorage.getItem('app-header');
            if (header) html.classList.add(header);
            if (localStorage.getItem('app-skin-dark') === 'app-skin-dark') html.classList.add('app-skin-dark');
            var font = localStorage.getItem('font-family');
            if (font) html.classList.add(font);

            document.addEventListener('click', function (e) {
                if (!e.target.closest('.dark-button, .light-button')) return;
                html.classList.add('theme-switching');
                requestAnimationFrame(function () {
                    requestAnimationFrame(function () {
                        html.classList.remove('theme-switching');
                    });
                });
            }, true);
        })();
    </script>

    <link rel="shortcut icon" type="image/x-icon" href="~/assets/images/logo-abbr.png">
    <link rel="stylesheet" type="text/css" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/assets/vendors/css/vendors.min.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/theme.min.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/custom-fixes.css">
    <style>
        .nxl-header { top: 0 !important; }

        .page-header {
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        html.minimenu .nxl-navigation .m-header .logo-lg { display: none !important; }
        html.minimenu .nxl-navigation .m-header .logo-sm { display: block !important; }
        html:not(.minimenu) .nxl-navigation .m-header .logo-sm { display: none !important; }

        html.app-skin-dark .nxl-navigation .m-header .logo-lg,
        html.app-skin-dark .nxl-navigation .m-header .logo-sm,
        html.app-navigation-dark .nxl-navigation .m-header .logo-lg,
        html.app-header-dark .nxl-navigation .m-header .logo-lg,
        html.app-navigation-dark .nxl-navigation .m-header .logo-sm,
        html.app-header-dark .nxl-navigation .m-header .logo-sm {
            filter: none !important;
        }

        html.app-skin-dark .nxl-navigation .m-header,
        html.app-navigation-dark .nxl-navigation .m-header,
        html.app-header-dark .nxl-navigation .m-header {
            color: #fff !important;
        }
        html.app-skin-dark .nxl-navigation .m-header a,
        html.app-navigation-dark .nxl-navigation .m-header a,
        html.app-header-dark .nxl-navigation .m-header a,
        html.app-skin-dark .nxl-navigation .m-header .brand-text,
        html.app-navigation-dark .nxl-navigation .m-header .brand-text,
        html.app-header-dark .nxl-navigation .m-header .brand-text {
            color: inherit !important;
        }

        .btn-action {
            --bs-btn-padding-y: 0.5rem;
            --bs-btn-padding-x: 0.9rem;
            --bs-btn-font-size: 0.95rem;
        }
        .btn-action.btn-action-icon { --bs-btn-padding-x: 0.75rem; }
        .btn-action i { font-size: 1.05em; line-height: 1; }
        .btn-action svg { width: 18px; height: 18px; }

        .badge-action {
            display: inline-flex;
            align-items: center;
            padding: 0.5rem 0.9rem;
            font-size: 0.95rem;
            border-radius: 0.375rem;
        }
    </style>
</head>

<body>

    <partial name="_Sidebar" />
    <script>
        (function () {
            var nav = document.querySelector('.navbar-content');
            if (!nav) return;
            var saved = sessionStorage.getItem('sidebar-scroll-top');
            if (saved) nav.scrollTop = parseInt(saved, 10);
            var save = function () { sessionStorage.setItem('sidebar-scroll-top', String(nav.scrollTop)); };
            nav.addEventListener('scroll', save, { passive: true });
            window.addEventListener('beforeunload', save);
        })();
    </script>

    <main class="nxl-container">
        <div class="nxl-wrap">

            <partial name="_Topbar" />

            <div class="nxl-content">
                <div class="page-header">
                    <div class="page-header-left d-flex align-items-center flex-grow-1">
                        <div class="page-header-title">
                            <h5 class="m-0">@(ViewData["Title"] ?? "Dashboard")</h5>
                        </div>
                    </div>
                    <div class="page-header-right ms-auto">
                        @await RenderSectionAsync("PageActions", required: false)
                    </div>
                </div>
                <div class="main-content">
                    @RenderBody()
                </div>
            </div>

            <footer class="nxl-footer">
                <div class="footer-wrapper" style="display:flex; justify-content:center; align-items:center; padding:14px 20px; border-top:1px solid rgba(0,0,0,.08);">
                    <p class="fs-11 text-muted mb-0" style="letter-spacing:.3px;">
                        &copy; @DateTime.Now.Year <span style="font-weight:600;">SDIT AL IKHLAS 86</span>. Data Master.
                    </p>
                </div>
            </footer>

        </div>
    </main>

    <script src="~/assets/vendors/js/vendors.min.js"></script>
    <script src="~/assets/js/common-init.min.js"></script>
    <script src="~/assets/js/theme-customizer-init.min.js"></script>
    <script src="~/assets/vendors/js/sweetalert2.min.js"></script>

    <partial name="_FlashMessages" />

    <script>
        var LOGOUT_URL = '@Url.Action("Logout", "Auth")';

        document.querySelectorAll('#btnLogout, #sidebarBtnLogout').forEach(function (el) {
            el.addEventListener('click', function (e) {
                e.preventDefault();
                var dest = this.getAttribute('href');
                if (!dest || dest === '#') dest = LOGOUT_URL;
                Swal.fire({
                    title: 'Keluar?',
                    text: 'Apakah Anda yakin ingin logout?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Ya, Logout',
                    cancelButtonText: 'Batal',
                    confirmButtonColor: '#d33'
                }).then(function (result) {
                    if (result.isConfirmed) window.location.href = dest;
                });
            });
        });

        document.addEventListener('show.bs.modal', function (e) {
            if (e.target.parentElement !== document.body) {
                document.body.appendChild(e.target);
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
