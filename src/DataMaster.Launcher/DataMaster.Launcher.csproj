<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DataMaster.Data\DataMaster.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- Windows Service (2026-09-12) - lihat WindowsServiceHelper.cs. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dijadikan Resource (bukan cuma ApplicationIcon di atas) supaya URI
         relatif "app.ico" pada atribut Icon= tiap Window (title bar/Alt-Tab)
         benar2 bisa di-resolve WPF saat runtime - ApplicationIcon SENDIRI
         cuma menempel jadi resource Win32 utk ikon .exe (Explorer/taskbar),
         TIDAK otomatis ikut ke pack resource yang dipakai Window.Icon. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Dibandingkan UpdateChecker terhadap tag rilis GitHub (vX.Y.Z) - naikkan
         tiap kali CI/CD menerbitkan rilis baru. -->
    <Version>1.0.0</Version>
    <!-- Logo resmi Yayasan Al-Ikhlas 86 (2026-09-12, permintaan eksplisit user)
         - dipakai icon .exe (Explorer/taskbar) DAN icon tiap jendela (title
         bar/Alt-Tab, lihat atribut Icon= di masing2 .xaml). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- BUG NYATA (2026-09-14, ketahuan lewat log auto-update sungguhan di
         lapangan - unduhan v1.4.7 sukses, tapi ApplyAndRestart lempar
         FileNotFoundException "System.IO.Compression.ZipFile"): publish
         self-contained hasil GitHub Actions (windows-latest, SDK "10.0.x"
         mengambang) diam2 TIDAK menyertakan System.IO.Compression.ZipFile.dll
         dkk, padahal publish lokal (SDK 10.0.103) menyertakannya dgn benar -
         dibuktikan langsung, bukan dugaan (lihat D:\Z Data Master hasil rilis
         v1.4.6 CI: folder System.IO.Compression.* kosong sama sekali).
         PublishTrimmed eksplisit false + TrimmerRootAssembly memaksa
         assembly ini SELALU ikut apa pun versi SDK yang dipakai. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="System.IO.Compression.ZipFile" />
  </ItemGroup>

</Project>
