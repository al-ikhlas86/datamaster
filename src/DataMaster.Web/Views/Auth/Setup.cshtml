@model DataMaster.Web.Models.Auth.SetupInput
@{
    Layout = null;
    ViewData["Title"] = "Setup Awal";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Setup Awal - Sistem Arsip Data SDIT AL IKHLAS 86</title>
    <link rel="shortcut icon" type="image/x-icon" href="~/assets/images/logo-abbr.png">
    <link rel="stylesheet" type="text/css" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/assets/vendors/css/vendors.min.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/theme.min.css">
</head>
<body>
    <main class="auth-cover-wrapper">
        <div class="auth-cover-content-inner">
            <div class="auth-cover-content-wrapper">
                <div class="auth-img">
                    <img src="~/assets/images/logo-abbr.png" alt="Logo" class="img-fluid mx-auto d-block" style="width: 100%; max-width: 420px;">
                </div>
            </div>
        </div>
        <div class="auth-cover-sidebar-inner">
            <div class="auth-cover-card-wrapper">
                <div class="auth-cover-card p-sm-5">
                    <h2 class="fs-20 fw-bolder mb-1">Setup Awal</h2>
                    <h4 class="fs-13 fw-bold mb-2">Data Master SDIT AL IKHLAS 86</h4>
                    <p class="fs-12 fw-medium text-muted">Belum ada akun sama sekali di aplikasi ini. Buat akun admin pertama untuk mulai memakai Data Master. Setelah ini, akun baru lain hanya bisa dibuat oleh admin yang sudah masuk.</p>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@err.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <form asp-controller="Auth" asp-action="Setup" method="post" class="w-100 mt-3">
                        <div class="mb-3">
                            <label class="form-label">ID *</label>
                            <input type="text" name="Username" class="form-control" value="@Model.Username" minlength="3" maxlength="30" required autofocus>
                            <div class="form-text">Dipakai untuk login - bisa diganti kapan saja lewat menu Pengaturan setelah masuk.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Kata Sandi *</label>
                            <input type="password" name="Password" class="form-control" minlength="8" required>
                            <div class="form-text">Minimal 8 karakter.</div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Konfirmasi Kata Sandi *</label>
                            <input type="password" name="PasswordKonfirmasi" class="form-control" minlength="8" required>
                        </div>

                        <hr class="my-4">
                        <p class="fs-12 fw-medium text-muted mb-2">Sinkronisasi Hub API (opsional - boleh dilewati &amp; diaktifkan belakangan).</p>
                        <div class="mb-4">
                            <label class="form-label">Nama Unit</label>
                            <input type="text" id="namaUnit" name="NamaUnit" class="form-control" placeholder="Contoh: TK Al Ikhlas 86" value="@Model.NamaUnit">
                            <div class="form-text">Isi supaya data unit ini otomatis tersambung ke Mobile-app/Webview - tidak perlu alamat server atau token apapun, cukup nama unitnya saja.</div>
                        </div>

                        <button type="submit" class="btn btn-lg btn-primary w-100">Buat Akun Admin</button>
                    </form>
                </div>
            </div>
        </div>
    </main>
    <script src="~/assets/vendors/js/vendors.min.js"></script>
    <script src="~/assets/js/common-init.min.js"></script>
    <script src="~/assets/js/theme-customizer-init.min.js"></script>
</body>
</html>
